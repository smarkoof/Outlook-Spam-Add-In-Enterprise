# =============================================================================
#  deploy.env — personnalisation du complément OWA. Copier en « deploy.env »
#  (chmod 600), remplir, puis ./apply-config.sh génère tout dans deploy/out/.
#  (Aucun secret ici : l'adresse abuse et l'URL du manifeste.)
# =============================================================================

ADDIN_FQDN="addin.interne.example"   # hôte HTTPS interne qui servira le complément (= SAN du certificat)

ADDIN_ID=""                      # GUID du manifeste ; VIDE = généré automatiquement
ABUSE_TO=""                      # OBLIGATOIRE : boîte abuse (ex. abuse@votredomaine.example)
ABUSE_CC=""                      # optionnel
REPORT_SUBJECT_PREFIX="[SPAM]"   # préfixe d'objet du rapport (parité VSTO)
